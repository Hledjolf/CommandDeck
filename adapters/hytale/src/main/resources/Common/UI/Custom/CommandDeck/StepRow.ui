// One step in the macro editor. #Depth shows how deep it is nested; the buttons move it up or down, out of
// or into the repeat or group above it, or delete it with everything inside.
$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 4);

  Label #Depth {
    Text: "";
    Anchor: (Width: 60, Right: 4);
    Style: (FontSize: 16, RenderBold: true, TextColor: #7a9cc6, VerticalAlignment: Center, HorizontalAlignment: End);
  }

  Label #Kind {
    Text: "";
    Anchor: (Width: 110, Right: 8);
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
  }

  $C.@TextField #Input {
    @Anchor = (Right: 8);
    FlexWeight: 1;
  }

  Group {
    Anchor: (Width: 30, Right: 4);

    $C.@CheckBox #Flag {
      Anchor: (Width: 26, Height: 26, Left: 0, Top: 7);
    }
  }

  Label #FlagLabel {
    Text: "";
    Anchor: (Width: 70, Right: 8);
    Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center);
  }

  $C.@SmallSecondaryTextButton #Up {
    @Text = "Up";
    @Anchor = (Width: 52, Top: 4, Right: 4);
    Padding: (Horizontal: 0);
  }

  $C.@SmallSecondaryTextButton #Down {
    @Text = "Down";
    @Anchor = (Width: 64, Top: 4, Right: 4);
    Padding: (Horizontal: 0);
  }

  $C.@SmallSecondaryTextButton #Out {
    @Text = "<";
    @Anchor = (Width: 40, Top: 4, Right: 4);
    Padding: (Horizontal: 0);
  }

  $C.@SmallSecondaryTextButton #In {
    @Text = ">";
    @Anchor = (Width: 40, Top: 4, Right: 4);
    Padding: (Horizontal: 0);
  }

  $C.@SmallSecondaryTextButton #Del {
    @Text = "X";
    @Anchor = (Width: 40, Top: 4);
    Padding: (Horizontal: 0);
  }
}
