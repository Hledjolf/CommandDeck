// The macro editor's buttons: add a step of each kind, then Delete, Run and Save. They add up to 800 pixels,
// inside the right pane's ~806: Save at 170 ran off the window's edge. "+ Call" (1.2) took 4 to 20 pixels from each.
// "+ Loop" (1.2) took the place of "+ Repeat": it adds a Repeat, which its row's selector makes a While or Until.
$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 44);

  $C.@SmallSecondaryTextButton #AddCommand {
    @Text = "+ Command";
    @Anchor = (Width: 116, Top: 4, Right: 4);
  }

  $C.@SmallSecondaryTextButton #AddWait {
    @Text = "+ Wait";
    @Anchor = (Width: 80, Top: 4, Right: 4);
  }

  $C.@SmallSecondaryTextButton #AddLoop {
    @Text = "+ Loop";
    @Anchor = (Width: 100, Top: 4, Right: 4);
  }

  $C.@SmallSecondaryTextButton #AddSequence {
    @Text = "+ Group";
    @Anchor = (Width: 92, Top: 4, Right: 4);
  }

  $C.@SmallSecondaryTextButton #AddCall {
    @Text = "+ Call";
    @Anchor = (Width: 80, Top: 4, Right: 8);
  }

  Group {
    FlexWeight: 1;
  }

  $C.@SecondaryTextButton #Delete {
    @Text = "Delete";
    @Anchor = (Right: 8, Width: 96);
  }

  $C.@SecondaryTextButton #RunMacro {
    @Text = "Run";
    @Anchor = (Right: 8, Width: 96);
  }

  $C.@TextButton #Save {
    @Text = "Save";
    @Anchor = (Width: 100);
  }
}
